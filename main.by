import os
import discord
from discord.ext import commands
from google import genai

# قراءة المفاتيح بأمان من إعدادات الاستضافة أو الجهاز
DISCORD_BOT_TOKEN = os.getenv("DISCORD_BOT_TOKEN")
GEMINI_API_KEY = os.getenv("GEMINI_API_KEY")
ERROR_CHANNEL_ID = os.getenv(
    "ERROR_CHANNEL_ID"
)  # سيتم ربطه لاحقاً أو وضعه كرقماً هنا إذا أردت

client = genai.Client(api_key=GEMINI_API_KEY)

intents = discord.Intents.default()
intents.message_content = True
bot = commands.Bot(command_prefix="!", intents=intents)


@bot.event
async def on_ready():
  print(f"✅ تم تسجيل الدخول بنجاح باسم: {bot.user}")


@bot.event
async def on_message(message):
  if message.author == bot.user:
    return

  if bot.user.mentioned_in(message) or isinstance(
      message.channel, discord.DMChannel
  ):
    user_text = message.content.replace(f"<@{bot.user.id}>", "").strip()
    if user_text:
      async with message.channel.typing():
        try:
          response = client.models.generate_content(
              model="gemini-2.5-flash", contents=user_text
          )
          reply = response.text
          if len(reply) > 2000:
            reply = reply[:1995] + "..."
          await message.reply(reply)
        except Exception as e:
          await message.reply(f"❌ حدث خطأ في الذكاء الاصطناعي: {e}")

  await bot.process_commands(message)


if __name__ == "__main__":
  bot.run(DISCORD_BOT_TOKEN)